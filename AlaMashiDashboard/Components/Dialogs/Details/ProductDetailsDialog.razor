@namespace AlaMashi.AdminDashboard.Components.Dialogs
@using global::AdminDashboard.Services
@inject LocalizationService Localization
@inject IConfiguration Configuration

<MudDialog ClassActions="dialog-actions-improved" Style="max-width: 1100px;">
    <TitleContent>
        <div class="d-flex align-center gap-2 pa-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); margin: -24px -24px 0 -24px; border-radius: 12px 12px 0 0;">
            <MudIcon Icon="@Icons.Material.Filled.Inventory" Color="Color.Surface" Size="Size.Large" />
            <div>
                <MudText Typo="Typo.h5" Class="font-weight-bold text-white">@Localization.Get("dialog.product_details")</MudText>
                <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.9);">@Localization.Get("products.complete_info")</MudText>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <div style="max-height: 70vh; overflow-y: auto; padding: 16px;">
            <MudGrid Spacing="3">

                @* صورة المنتج *@
                <MudItem xs="12" md="5">
                    <MudPaper Elevation="3" Class="pa-4 product-image-container" Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 16px; position: relative; height: 100%;">
                        @if (!string.IsNullOrEmpty(ProductDetails.MainImageURL))
                        {
                            <MudBadge Color="Color.Success"
                                      Content="@($"ID: {ProductDetails.ProductID}")"
                                      Overlap="true"
                                      Class="product-badge">
                                @if (_imageLoadError)
                                {
                                    <div style="width: 100%; height: 320px; background: white; border-radius: 12px; display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 24px rgba(0,0,0,0.15);">
                                        <div class="text-center pa-4">
                                            <MudIcon Icon="@Icons.Material.Filled.BrokenImage" Size="Size.Large" Color="Color.Error" Style="font-size: 4rem; opacity: 0.5;" />
                                            <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-2">فشل تحميل الصورة</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">@_errorMessage</MudText>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <img src="@GetFullImageUrl()"
                                         alt="@ProductDetails.ProductName"
                                         style="width: 100%; height: 320px; object-fit: contain; background: white; box-shadow: 0 8px 24px rgba(0,0,0,0.15); border-radius: 12px; transition: transform 0.3s ease;"
                                         class="product-image"
                                         @onerror="HandleImageError" />
                                }
                            </MudBadge>
                        }
                        else
                        {
                            <div style="width: 100%; height: 320px; background: #f8fafc; border-radius: 12px; display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 24px rgba(0,0,0,0.15);">
                                <div class="text-center pa-4">
                                    <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Size="Size.Large" Color="Color.Secondary" Style="font-size: 5rem; opacity: 0.3;" />
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">@Localization.Get("products.no_image")</MudText>
                                </div>
                            </div>
                        }
                    </MudPaper>
                </MudItem>

                @* معلومات المنتج *@
                <MudItem xs="12" md="7">
                    <MudStack Spacing="3">

                        @* العنوان والسعر *@
                        <MudPaper Elevation="2" Class="pa-4" Style="border-radius: 16px; background: linear-gradient(145deg, #ffffff 0%, #f8fafc 100%);">
                            <div class="d-flex align-center justify-space-between mb-3 flex-wrap gap-3">
                                <div class="flex-grow-1">
                                    <MudText Typo="Typo.h4" Class="font-weight-bold mb-2" Style="color: #1e293b; line-height: 1.3;">
                                        @ProductDetails.ProductName
                                    </MudText>
                                    <div class="d-flex align-center gap-2 flex-wrap">
                                        <MudChip Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.Category" Variant="Variant.Filled">
                                            @ProductDetails.CategoryName
                                        </MudChip>
                                        @if (!string.IsNullOrEmpty(ProductDetails.Barcode))
                                        {
                                            <MudChip Size="Size.Small" Color="Color.Default" Icon="@Icons.Material.Filled.QrCode" Variant="Variant.Outlined">
                                                @ProductDetails.Barcode
                                            </MudChip>
                                        }
                                    </div>
                                </div>
                                <div class="text-end price-section">
                                    <MudText Typo="Typo.h3" Color="Color.Success" Class="font-weight-bold" Style="line-height: 1;">
                                        @ProductDetails.Price.ToString("N2")
                                    </MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Localization.Get("units.egp")</MudText>
                                </div>
                            </div>

                            <MudDivider Class="my-3" />

                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mb-2 d-flex align-center gap-1 font-weight-bold">
                                <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />
                                @Localization.Get("dialog.description")
                            </MudText>
                            <MudText Typo="Typo.body1" Style="line-height: 1.8; color: #475569;">
                                @(string.IsNullOrEmpty(ProductDetails.ProductDescription) ? Localization.Get("products.no_description") : ProductDetails.ProductDescription)
                            </MudText>
                        </MudPaper>

                        @* إحصائيات المنتج *@
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6">
                                <MudPaper Elevation="2" Class="pa-3 stat-card" Style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border-radius: 12px; color: white; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);">
                                    <div class="d-flex align-center gap-2 mb-1">
                                        <MudIcon Icon="@Icons.Material.Filled.Inventory" Color="Color.Surface" Size="Size.Small" />
                                        <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.95); font-weight: 500;">@Localization.Get("products.stock")</MudText>
                                    </div>
                                    <MudText Typo="Typo.h4" Class="font-weight-bold my-1">@ProductDetails.QuantityInStock</MudText>
                                    <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.8);">@Localization.Get("units.pieces")</MudText>
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudPaper Elevation="2" Class="pa-3 stat-card" Style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); border-radius: 12px; color: white; box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);">
                                    <div class="d-flex align-center gap-2 mb-1">
                                        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Color="Color.Surface" Size="Size.Small" />
                                        <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.95); font-weight: 500;">@Localization.Get("dialog.total_orders")</MudText>
                                    </div>
                                    <MudText Typo="Typo.h4" Class="font-weight-bold my-1">@(ProductDetails.Orders?.Count ?? 0)</MudText>
                                    <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.8);">@Localization.Get("orders.orders")</MudText>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>

                    </MudStack>
                </MudItem>

                @* جدول الطلبات *@
                @if (ProductDetails.Orders != null && ProductDetails.Orders.Any())
                {
                    <MudItem xs="12">
                        <MudPaper Elevation="2" Class="pa-4" Style="border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);">
                            <div class="d-flex align-center justify-space-between mb-3">
                                <MudText Typo="Typo.h6" Class="font-weight-bold d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Color="Color.Primary" />
                                    @Localization.Get("dialog.recent_orders")
                                </MudText>
                                <MudChip Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                                    @ProductDetails.Orders.Count @Localization.Get("orders.orders")
                                </MudChip>
                            </div>

                            <MudTable Items="@ProductDetails.Orders.Take(5)"
                                      Dense="true"
                                      Hover="true"
                                      Bordered="true"
                                      Striped="true"
                                      Style="border-radius: 8px; overflow: hidden;">
                                <HeaderContent>
                                    <MudTh Style="background: #f1f5f9;">
                                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@Localization.Get("orders.order_id")</MudText>
                                    </MudTh>
                                    <MudTh Style="background: #f1f5f9;">
                                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@Localization.Get("orders.customer")</MudText>
                                    </MudTh>
                                    <MudTh Style="background: #f1f5f9;">
                                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@Localization.Get("dialog.quantity")</MudText>
                                    </MudTh>
                                    <MudTh Style="background: #f1f5f9;">
                                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@Localization.Get("orders.order_date")</MudText>
                                    </MudTh>
                                    <MudTh Style="background: #f1f5f9; text-align: center;">
                                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@Localization.Get("orders.total_amount")</MudText>
                                    </MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="@Localization.Get("orders.order_id")">
                                        <MudChip Size="Size.Small" Color="Color.Primary" Icon="@Icons.Material.Filled.Receipt">#@context.OrderId</MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="@Localization.Get("orders.customer")">
                                        <div class="d-flex align-center gap-2">
                                            <MudAvatar Size="Size.Small" Color="Color.Secondary">
                                                @context.CustomerName?.FirstOrDefault()
                                            </MudAvatar>
                                            <MudText Typo="Typo.body2">@context.CustomerName</MudText>
                                        </div>
                                    </MudTd>
                                    <MudTd DataLabel="@Localization.Get("dialog.quantity")">
                                        <MudChip Size="Size.Small" Color="Color.Info">@context.Quantity</MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="@Localization.Get("orders.order_date")">
                                        <MudText Typo="Typo.body2">@context.OrderDate.ToString("dd MMM yyyy")</MudText>
                                    </MudTd>
                                    <MudTd DataLabel="@Localization.Get("orders.total_amount")" Style="text-align: center;">
                                        <MudText Typo="Typo.body1" Class="font-weight-bold" Color="Color.Success">
                                            @context.Subtotal.ToString("N2") @Localization.Get("units.egp")
                                        </MudText>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>

                            @if (ProductDetails.Orders.Count > 5)
                            {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                                    @Localization.Get("dialog.showing_first_5_orders") (@ProductDetails.Orders.Count @Localization.Get("orders.total"))
                                </MudAlert>
                            }
                        </MudPaper>
                    </MudItem>
                }

            </MudGrid>
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Close"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Close"
                   Size="Size.Medium"
                   Class="px-6">
            @Localization.Get("common.close")
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .product-image-container {
        animation: fadeInScale 0.5s ease-out;
    }

    .product-image {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .product-image:hover {
            transform: scale(1.05);
            box-shadow: 0 12px 32px rgba(0,0,0,0.2) !important;
        }

    .product-badge {
        position: absolute;
        top: 20px;
        right: 20px;
        z-index: 10;
    }

    .stat-card {
        animation: fadeIn 0.7s ease-out;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .stat-card:hover {
            transform: translateY(-4px) scale(1.02);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2) !important;
        }

    .price-section {
        animation: pulse 2s infinite;
    }

    @@keyframes fadeInScale {
        from {
            opacity: 0;
            transform: scale(0.95);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.03);
        }
    }
</style>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public ProductDetailsDto ProductDetails { get; set; } = null!;

    private bool _imageLoadError = false;
    private string? _errorMessage;
    private string? _baseApiUrl;

    protected override void OnInitialized()
    {
        _baseApiUrl = Configuration["ApiBaseAddress"]?.TrimEnd('/');
    }

    /// <summary>
    /// بناء رابط الصورة الكامل مباشرة من Backend
    /// </summary>
    private string GetFullImageUrl()
    {
        if (string.IsNullOrEmpty(ProductDetails.MainImageURL))
            return string.Empty;

        // إذا كان اللينك كامل (يبدأ بـ http/https)
        if (ProductDetails.MainImageURL.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            ProductDetails.MainImageURL.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return ProductDetails.MainImageURL;
        }

        // بناء الرابط الكامل
        return $"{_baseApiUrl}/{ProductDetails.MainImageURL.TrimStart('/')}";
    }

    private void HandleImageError(ErrorEventArgs args)
    {
        _imageLoadError = true;
        _errorMessage = $"URL: {GetFullImageUrl()}";
        Console.WriteLine($"❌ Error loading image: {GetFullImageUrl()}");
        StateHasChanged();
    }

    private void Close() => MudDialog.Close();

    public class ProductDetailsDto
    {
        [JsonPropertyName("productID")] public int ProductID { get; set; }
        [JsonPropertyName("productName")] public string ProductName { get; set; } = string.Empty;
        [JsonPropertyName("productDescription")] public string ProductDescription { get; set; } = string.Empty;
        [JsonPropertyName("barcode")] public string? Barcode { get; set; }
        [JsonPropertyName("price")] public decimal Price { get; set; }
        [JsonPropertyName("quantityInStock")] public int QuantityInStock { get; set; }
        [JsonPropertyName("mainImageURL")] public string MainImageURL { get; set; } = string.Empty;
        [JsonPropertyName("categoryId")] public int CategoryId { get; set; }
        [JsonPropertyName("categoryName")] public string CategoryName { get; set; } = string.Empty;
        [JsonPropertyName("orders")] public List<OrderDto>? Orders { get; set; }
    }

    public class OrderDto
    {
        [JsonPropertyName("orderId")] public int OrderId { get; set; }
        [JsonPropertyName("quantity")] public int Quantity { get; set; }
        [JsonPropertyName("orderDate")] public DateTime OrderDate { get; set; }
        [JsonPropertyName("subtotal")] public decimal Subtotal { get; set; }
        [JsonPropertyName("customerName")] public string CustomerName { get; set; } = "N/A";
    }
}